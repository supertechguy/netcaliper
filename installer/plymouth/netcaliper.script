# netcaliper boot splash (Plymouth script plugin). splash.png is rendered by the installer
# (`netcaliper splash`), already rotated for portrait panels the kiosk turns to landscape.

Window.SetBackgroundTopColor(0.016, 0.035, 0.016);
Window.SetBackgroundBottomColor(0.016, 0.035, 0.016);

logo.image = Image("splash.png");
logo.sprite = Sprite(logo.image);
logo.sprite.SetX(Window.GetX() + (Window.GetWidth() - logo.image.GetWidth()) / 2);
logo.sprite.SetY(Window.GetY() + (Window.GetHeight() - logo.image.GetHeight()) / 2);

# Gentle phosphor pulse while booting (called ~50x per second).
tick = 0;
fun refresh_cb() {
    tick++;
    logo.sprite.SetOpacity(0.8 + 0.2 * Math.Sin(tick / 20));
}
Plymouth.SetRefreshFunction(refresh_cb);

# Prompts (e.g. an encrypted root) must stay usable: plain text near the bottom.
fun show_text(text) {
    prompt.image = Image.Text(text, 0.22, 1.0, 0.42);
    prompt.sprite = Sprite(prompt.image);
    prompt.sprite.SetX(Window.GetX() + (Window.GetWidth() - prompt.image.GetWidth()) / 2);
    prompt.sprite.SetY(Window.GetY() + Window.GetHeight() * 0.85);
}
fun display_password_cb(text, bullets) {
    stars = "";
    for (i = 0; i < bullets; i++) stars += "*";
    show_text(text + " " + stars);
}
fun display_question_cb(text, entry) { show_text(text + " " + entry); }
fun display_normal_cb() { prompt.sprite = NULL; }
fun message_cb(text) { show_text(text); }
Plymouth.SetDisplayPasswordFunction(display_password_cb);
Plymouth.SetDisplayQuestionFunction(display_question_cb);
Plymouth.SetDisplayNormalFunction(display_normal_cb);
Plymouth.SetMessageFunction(message_cb);
