// SPDX-License-Identifier: GPL-3.0-only
// LOCAL DEVELOPMENT ONLY: `npm run dev`. Never deploy this config (no routes; src/dev.ts signs a fake
// Access identity for localhost). Production: wrangler.jsonc.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "netcaliper-dev",
  "main": "src/dev.ts",
  "compatibility_date": "2026-11-20",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [{ "binding": "DB", "database_name": "netcaliper", "migrations_dir": "migrations" }],
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "triggers": { "crons": ["17 3 * * *"] },
  "vars": { "ACCESS_TEAM_DOMAIN": "", "ACCESS_AUD": "", "DAILY_ROW_BUDGET": "100000" }
}
